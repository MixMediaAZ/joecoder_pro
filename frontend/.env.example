#
# JoeCoder Pro Frontend deployment environment
#

# Public frontend URL (for production browser links)
NEXT_PUBLIC_APP_URL=https://your-frontend-domain.example

# JoeCoder backend origin used by Next rewrites:
# /api/v1/* -> ${JC_BACKEND_ORIGIN}/api/v1/*
# /health   -> ${JC_BACKEND_ORIGIN}/health
JC_BACKEND_ORIGIN=http://127.0.0.1:3000

# Optional compatibility fallback
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000

# Optional: used by "More options" deployment profile health checks
NEXT_PUBLIC_STAGING_BACKEND_ORIGIN=https://staging-backend.example
NEXT_PUBLIC_PRODUCTION_BACKEND_ORIGIN=https://prod-backend.example
