# ========================================
# T.H.E.N EI NEURAL ENTANGLEMENT PLATFORM
# API KEY CONFIGURATION TEMPLATE
# ========================================
# COPY THIS FILE TO .env AND ADD YOUR API KEYS
# ========================================

# ========================================
# CORE AI APIs
# ========================================

# OpenAI API Keys (GPT-4, DALL-E 3, Whisper)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Anthropic API Keys (Claude 3.5 Sonnet, Claude 3.5 Haiku)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# Perplexity API Keys (Real-time web search and synthesis)
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key-here
SERPER_KEY=your-serper-key-here
# ========================================
# VISUAL & CREATIVE APIs
# ========================================

# Stability AI API Keys (Stable Diffusion, SDXL Turbo)
# Get from: https://platform.stability.ai/
STABILITY_API_KEY=sk-your-stability-api-key-here
# Hugging Face API Keys (Open-source AI models)
# Get from: https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=hf-your-huggingface-api-key-here

# Replicate API Keys (Cloud-based AI model hosting)
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=r8_your-replicate-api-key-here
# ========================================
# DEVELOPMENT & UTILITY APIs
# ========================================

# GitHub API Token (Code repository integration)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp-your-github-token-here
# GitHub Copilot Token (AI-powered coding assistance)
# Get from: https://github.com/settings/copilot
GITHUB_COPILOT_TOKEN=ghp-your-copilot-token-here

# ========================================
# DATABASE CONFIGURATION
# ========================================

# Neon PostgreSQL Database (Primary)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# ========================================
# FLASK CONFIGURATION
# ========================================

# Flask Secret Key (Change in production)
SECRET_KEY=your-secret-key-here

# Flask Environment
FLASK_ENV=development

# Flask Debug Mode
FLASK_DEBUG=True

# ========================================
# T.H.E.N EI SPECIFIC CONFIGURATION
# ========================================

# Neural Entanglement Platform Mode
THEN_EI_MODE=neural_entanglement

# Cognitive Processing Mode
COGNITIVE_MODE=analytical

# API Rate Limiting
API_RATE_LIMIT=100 per hour

# Maximum File Upload Size (16MB)
MAX_CONTENT_LENGTH=16777216

# ========================================
# SESSION CONFIGURATION
# ========================================

# Session Secret
SESSION_SECRET=your-session-secret-here
# Session Type
SESSION_TYPE=filesystem

# Session Permanent
SESSION_PERMANENT=False

# ========================================
# LOGGING CONFIGURATION
# ========================================

# Log Level
LOG_LEVEL=INFO

# Log File
LOG_FILE=logs/then_ei_platform.log

# ========================================
# SECURITY CONFIGURATION
# ========================================

# CORS Origins (Allowed origins for cross-origin requests)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ========================================
# PERFORMANCE CONFIGURATION
# ========================================

# Database Pool Recycle (5 minutes)
DB_POOL_RECYCLE=300

# Database Pool Pre Ping
DB_POOL_PRE_PING=True

# ========================================
# FEATURE FLAGS
# ========================================

# Enable Advanced Neural Processing
ENABLE_NEURAL_PROCESSING=True

# Enable Multi-Modal Synthesis
ENABLE_MULTI_MODAL=True

# Enable Real-time Processing
ENABLE_REALTIME_PROCESSING=True

# Enable Memory Systems
ENABLE_MEMORY_SYSTEMS=True

# Enable Visual Cortex
ENABLE_VISUAL_CORTEX=True

# Enable Social Intelligence
ENABLE_SOCIAL_INTELLIGENCE=True

# Enable Coding Systems
ENABLE_CODING_SYSTEMS=True

# ========================================
# MONITORING & ANALYTICS
# ========================================

# Enable System Monitoring
ENABLE_MONITORING=True

# Enable Performance Tracking
ENABLE_PERFORMANCE_TRACKING=True

# Enable Error Reporting
ENABLE_ERROR_REPORTING=True

# ========================================
# BACKUP & RECOVERY
# ========================================

# Enable Auto Backup
ENABLE_AUTO_BACKUP=True

# Backup Interval (hours)
BACKUP_INTERVAL=24

# ========================================
# MANDATE COMPLIANCE
# ========================================

# Allow progression beyond Stage 2 for mandate compliance
JC_ALLOW_POST_STAGE2=1