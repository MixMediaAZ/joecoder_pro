        "error",
        "warn",
        "info",
        "debug"
      ],
      "classification": "ordinary"
    },
    {
      "key": "JC_TELEMETRY_ENABLED",
      "type": "boolean",
      "default": false,
      "classification": "privacy_constrained"
    },
    {
