{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joecoder.local/plan-1.3/schemas/policy-decision.schema.json",
  "title": "JoeCoder Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "timestamp",
    "projectId",
    "workOrderId",
    "operation",
    "verdict",
    "ruleIds",
    "reasons",
    "normalizedInputHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "decisionId": {
      "type": "string",
      "minLength": 8
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "workOrderId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "allow",
        "deny",
        "needs_authorization"
      ]
    },
    "ruleIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^JC-[A-Z]+-[0-9]{3}$"
      }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requiredGrants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "normalizedInputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
