{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joecoder.local/plan-1.3/schemas/evidence-envelope.schema.json",
  "title": "JoeCoder Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "projectId",
    "projectVersion",
    "workOrderId",
    "runId",
    "kind",
    "verdict",
    "startedAt",
    "endedAt",
    "producer",
    "artifacts",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 8
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectVersion": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workOrderId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 8
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "survey",
        "install",
        "typecheck",
        "lint",
        "build",
        "unit",
        "contract",
        "integration",
        "e2e",
        "startup",
        "runtime",
        "browser",
        "accessibility",
        "security",
        "performance",
        "architecture",
        "policy",
        "transaction",
        "rollback",
        "provider",
        "forge",
        "package",
        "other"
      ]
    },
    "verdict": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "cancelled",
        "not_run",
        "unavailable",
        "inconclusive",
        "waived"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "command": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "executable",
        "args",
        "workingDirectoryHash",
        "exitCode"
      ],
      "properties": {
        "executable": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workingDirectoryHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environmentFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timedOut": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "summary": {
      "type": "string",
      "default": ""
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "mediaType",
          "redacted"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string"
          },
          "redacted": {
            "type": "boolean"
          }
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previousEventHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
