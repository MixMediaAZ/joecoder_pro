{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joecoder.local/plan-1.3/schemas/work-order.schema.json",
  "title": "JoeCoder Work Order 1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planVersion",
    "id",
    "projectId",
    "projectVersion",
    "sourcePlanHash",
    "sourceDetailHash",
    "sourceTraceabilityHash",
    "intent",
    "governanceMode",
    "roles",
    "objective",
    "deliverables",
    "nonGoals",
    "assumptions",
    "constraints",
    "dependencies",
    "ruleIds",
    "testIds",
    "fixtureIds",
    "scope",
    "plan",
    "acceptance",
    "risk",
    "authorization",
    "budgets",
    "rollback",
    "routing",
    "status",
    "timestamps",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3.0"
    },
    "id": {
      "type": "string",
      "pattern": "^(?:WO-[A-Z0-9][A-Z0-9-]{5,}|JC19-M[0-9]+-[0-9]{3})$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectVersion": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parentWorkOrderId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:WO-[A-Z0-9][A-Z0-9-]{5,}|JC19-M[0-9]+-[0-9]{3})$"
    },
    "intent": {
      "enum": [
        "build",
        "evaluate",
        "repair",
        "refactor",
        "test",
        "package",
        "deploy",
        "explain",
        "stabilize",
        "architecture_change",
        "plan_amendment"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "nonGoals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requiredState",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:WO-[A-Z0-9][A-Z0-9-]{5,}|JC19-M[0-9]+-[0-9]{3})$"
          },
          "requiredState": {
            "const": "completed"
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "operations",
        "commands",
        "network",
        "providers",
        "secrets"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "create",
              "update",
              "delete",
              "rename",
              "execute",
              "network",
              "provider",
              "package",
              "deploy"
            ]
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable",
              "arguments",
              "workingDirectory"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "workingDirectory": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "preconditions",
          "expectedOutcome",
          "acceptanceIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedOutcome": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "mandatory",
          "verifier",
          "status",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 10
          },
          "mandatory": {
            "type": "boolean"
          },
          "verifier": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "blocked",
              "not_run",
              "unavailable",
              "inconclusive",
              "waived"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "flags",
        "mitigations",
        "isolationRequired"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mitigations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "isolationRequired": {
          "enum": [
            "analysis_only",
            "native_constrained",
            "strong_isolated"
          ]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "grantIds",
        "approvedScopeHash",
        "expiresAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "awaiting",
            "approved",
            "denied",
            "expired",
            "revoked"
          ]
        },
        "grantIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvedScopeHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxFiles",
        "maxChangedLines",
        "maxAttempts",
        "maxDurationMs",
        "maxProcesses",
        "maxMemoryMb",
        "maxOutputBytes",
        "maxToolCalls",
        "maxCloudCostUsd"
      ],
      "properties": {
        "maxFiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxChangedLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800000
        },
        "maxProcesses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "maxMemoryMb": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxCloudCostUsd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "sourceVersion",
        "snapshotId",
        "restorationEvidenceRefs"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "version_pointer",
            "journaled_materialization",
            "none_read_only"
          ]
        },
        "sourceVersion": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshotId": {
          "type": [
            "string",
            "null"
          ]
        },
        "restorationEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacy",
        "preferredProvider",
        "selectedProvider",
        "selectedModel",
        "fallbacks",
        "decisionEvidenceRef"
      ],
      "properties": {
        "privacy": {
          "enum": [
            "local_only",
            "cloud_allowed_redacted",
            "cloud_allowed"
          ]
        },
        "preferredProvider": {
          "type": "string"
        },
        "selectedProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisionEvidenceRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "scoped",
        "planned",
        "policy_checked",
        "awaiting_authorization",
        "authorized",
        "snapshot_created",
        "executing_isolated",
        "verifying_staged",
        "review_ready",
        "awaiting_apply_authorization",
        "applying_transaction",
        "post_verifying",
        "prosecuting",
        "completed",
        "blocked",
        "failed",
        "cancelled",
        "rolled_back",
        "superseded",
        "inconclusive"
      ]
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ruleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^JC-[A-Z]+-[0-9]{3}$"
      }
    },
    "testIds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixtureIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^FX-[A-Z0-9]+-[0-9]{3}$"
      }
    },
    "sourceDetailHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceTraceabilityHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planVersion": {
      "const": "1.3.1"
    },
    "sourcePlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "governanceMode": {
      "enum": [
        "bootstrap_external",
        "governance_assisted",
        "broker_assisted",
        "transaction_assisted",
        "self_evaluation_candidate",
        "self_hosted_certified"
      ]
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "implementer",
        "verifier",
        "reviewer",
        "approver"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "implementer": {
          "type": "string",
          "minLength": 1
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "approver": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
